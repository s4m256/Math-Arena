<file path="src/components/Leaderboard.tsx">
import { createClient } from '@/lib/supabase/server'
import { leaderboard as fallbackLeaderboard } from '@/lib/data'

type LeaderboardProps = {
  contestId?: string
}

type LeaderboardEntry = {
  username: string
  score: number | null
}

export default async function Leaderboard({ contestId }: LeaderboardProps) {
  if (!contestId) {
    return <LeaderboardCard entries={fallbackLeaderboard} />
  }

  const supabase = await createClient()

  const { data: participations, error } = await supabase
    .from('contest_participations')
    .select('user_id, score')
    .eq('contest_id', contestId)
    .order('score', { ascending: false })

  if (error) {
    console.error('Erro ao buscar leaderboard:', formatSupabaseError(error))
    return (
      <div className="card">
        <h2>Leaderboard</h2>
        <p style={{ color: '#aaaaaa' }}>Erro ao carregar dados.</p>
      </div>
    )
  }

  const userIds = Array.from(
    new Set(
      participations
        ?.map((participation) => participation.user_id)
        .filter((userId): userId is string => Boolean(userId)) ?? []
    )
  )

  const usernamesById = new Map<string, string>()

  if (userIds.length > 0) {
    const { data: profiles, error: profilesError } = await supabase
      .from('profiles')
      .select('id, username')
      .in('id', userIds)

    if (profilesError) {
      console.error(
        'Erro ao buscar perfis do leaderboard:',
        formatSupabaseError(profilesError)
      )
    } else {
      profiles?.forEach((profile) => {
        if (profile.username) {
          usernamesById.set(profile.id, profile.username)
        }
      })
    }
  }

  const entries =
    participations?.map((participation) => ({
      username: participation.user_id
        ? usernamesById.get(participation.user_id) ?? 'Usuario desconhecido'
        : 'Usuario desconhecido',
      score: participation.score,
    })) ?? []

  return <LeaderboardCard entries={entries} />
}

function LeaderboardCard({ entries }: { entries: LeaderboardEntry[] }) {
  return (
    <div className="card">
      <h2>Leaderboard</h2>

      {entries.length === 0 ? (
        <p style={{ color: '#aaaaaa', marginTop: '10px' }}>
          Nenhum participante ainda. Seja o primeiro!
        </p>
      ) : (
        entries.map((entry, index) => (
          <div key={`${entry.username}-${index}`} className="leaderboard-item">
            <span>
              {getRankLabel(index)} {entry.username}
            </span>
            <span style={{ color: '#aaaaaa' }}>{entry.score} pts</span>
          </div>
        ))
      )}
    </div>
  )
}

function getRankLabel(index: number) {
  if (index === 0) return '1.'
  if (index === 1) return '2.'
  if (index === 2) return '3.'

  return `#${index + 1}`
}

function formatSupabaseError(error: unknown) {
  if (error instanceof Error) {
    return error.message
  }

  if (error && typeof error === 'object') {
    const { code, details, hint, message } = error as Record<string, unknown>

    return { code, details, hint, message }
  }

  return error
}
