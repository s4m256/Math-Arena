import Navbar from '@/components/Navbar'
import Leaderboard from '@/components/Leaderboard'
import ProblemCard from '@/components/ProblemCard'
import JoinContestButton from '@/components/JoinContestButton'
import { problems } from '@/lib/data'
import { createClient } from '@/lib/supabase/server'

// No Next.js App Router atual, params é um objeto de rota.
export default async function ContestPage({
  params,
}: {
  params: Promise<{ id: string }>
}) {
  const { id } = await params

  const supabase = await createClient()

  // Busca o contest no BANCO DE DADOS (não mais no data.ts)
  const { data: contest } = await supabase
    .from('contests')
    .select('*')
    .eq('id', id)
    .single()

  if (!contest) {
    return (
      <main className="container">
        <Navbar />
        <p>Contest não encontrado.</p>
      </main>
    )
  }

  // Verifica se o usuário está logado
  const {
    data: { user },
  } = await supabase.auth.getUser()

  // Verifica se o usuário já está participando desse contest
  let alreadyJoined = false
  if (user) {
    const { data: participation } = await supabase
      .from('contest_participations')
      .select('id')
      .eq('contest_id', id)
      .eq('user_id', user.id)
      .single()

    alreadyJoined = !!participation
  }

  return (
    <main className="container">
      <Navbar />

      <h1 className="title">{contest.title}</h1>

      <p className="subtitle">
        Duração: {contest.duration} • Status: {contest.status}
      </p>

      {/* Botão para entrar no contest — só aparece se estiver logado */}
      <JoinContestButton
        contestId={id}
        userId={user?.id ?? null}
        alreadyJoined={alreadyJoined}
      />

      {/* Problemas do contest */}
      {problems.map((problem) => (
        <ProblemCard key={problem.id} {...problem} />
      ))}

      {/* Leaderboard real do banco de dados */}
      <Leaderboard contestId={id} />
    </main>
  )
}
</file>

